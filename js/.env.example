# Place this file next to server.js (in the `js` folder). The server loads it by path, not by current working directory.
#
# If you see: querySrv ECONNREFUSED ... _mongodb._tcp...
# 1) In Atlas → Connect → Drivers, copy the "standard" mongodb://... connection string (3 hosts + replicaSet + ssl), OR
# 2) Keep mongodb+srv and try from another network / disable VPN / set Windows DNS to 1.1.1.1 or 8.8.8.8
#
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/DATABASE?retryWrites=true&w=majority
PORT=3000
